N_amostral <- c(5, 15, 30)[1]
## Definindo as proporções de amostragem
prop <- c("0-5" = 0.2, "5-10" = 0.5, "10-15" = 0.3)
# Número de amostras por estrato (arredondando)
n_por_estrato <- round(N_amostral * prop)
n_por_estrato
# Amostrando dentro de cada estrato
amostras_estratificadas <- unlist(lapply(names(n_por_estrato), function(estrato) {
subset_ids <- ESPACO_AMOSTRAL$ID[ESPACO_AMOSTRAL$Estrato == estrato]
sample(subset_ids, n_por_estrato[estrato])
}))
